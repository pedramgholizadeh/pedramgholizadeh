#!/usr/bin/env bash
# fit-size — keep a rendered video under a file-size budget without dropping fps.
#
#   fit-size <file.mp4> [max_mb]      re-encode only if the file is over budget
#
# Default budget: 200 MB. Output replaces the input (the original is kept as .bak).
# Encoding runs at half power, two-pass, and stays at 30 fps.
set -euo pipefail

SRC=${1:?usage: fit-size <file.mp4> [max_mb]}
MAX_MB=${2:-200}
CORES=$(sysctl -n hw.physicalcpu 2>/dev/null || echo 4)
HALF=$((CORES / 2)); [ "$HALF" -lt 1 ] && HALF=1

SIZE_BYTES=$(ffprobe -v error -show_entries format=size -of csv=p=0 "$SRC")
DUR=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$SRC")
BUDGET_BYTES=$(awk -v m="$MAX_MB" 'BEGIN{printf "%d", m*1000*1000}')

if [ "$SIZE_BYTES" -le "$BUDGET_BYTES" ]; then
  awk -v b="$SIZE_BYTES" -v m="$MAX_MB" 'BEGIN{printf "ok: %.0f MB of %s MB budget — no re-encode\n", b/1000000, m}'
  exit 0
fi

# Budget in megabits (decimal MB), minus a 128 kbit AAC track.
VIDEO_KBPS=$(awk -v m="$MAX_MB" -v d="$DUR" 'BEGIN{v=int(m*8*1000/d)-130; if(v<400)v=400; print v}')
TMP="${SRC%.mp4}-slim.mp4"
echo "over budget: $(awk -v b="$SIZE_BYTES" 'BEGIN{printf "%.2f MB", b/1000000}') → ${VIDEO_KBPS} kbit/s video, 30 fps, ${HALF} threads"

COMMON=(-map 0:v:0 -map 0:a? -c:v libx264 -preset slow -profile:v high -pix_fmt yuv420p
        -r 30 -threads "$HALF" -b:v "${VIDEO_KBPS}k" -maxrate "${VIDEO_KBPS}k"
        -bufsize "$((VIDEO_KBPS * 2))k")

taskpolicy -c background nice -n 15 ffmpeg -hide_banner -loglevel error -nostats -y -i "$SRC" \
  "${COMMON[@]}" -pass 1 -an -f mp4 /dev/null
taskpolicy -c background nice -n 15 ffmpeg -hide_banner -loglevel error -nostats -y -i "$SRC" \
  "${COMMON[@]}" -pass 2 -c:a aac -b:a 128k -movflags +faststart "$TMP"
rm -f ffmpeg2pass-0.log ffmpeg2pass-0.log.mbtree

mv "$SRC" "${SRC%.mp4}-oversize.bak.mp4"
mv "$TMP" "$SRC"
printf 'done: %.2f MB → %.2f MB (original kept as %s)\n' \
  "$(echo "$SIZE_BYTES" | awk '{print $1/1000000}')" \
  "$(stat -f%z "$SRC" | awk '{print $1/1000000}')" \
  "${SRC%.mp4}-oversize.bak.mp4"
